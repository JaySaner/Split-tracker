# SplitSmart — environment variables
#
# Copy this file to ".env.local" and fill in your own values. NEVER commit real keys.
#
#   cp .env.example .env.local
#
# Keep real values in .env.local. Restart `npm run dev` after changing this file.

# --- Hour 3: the AI brain (Google Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Supabase Auth + database ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
